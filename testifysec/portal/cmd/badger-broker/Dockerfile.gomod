# The module cache badger-broker's image is built from (Dockerfile, GOMOD_IMAGE). This is the one
# step that needs the network: build it where network is allowed, push it, and pin its digest
# where badger-broker is built. Every module is checked against go.sum as it is downloaded and
# again by `go mod verify` here; the badger-broker build verifies the cache once more, offline.
# Build from testifysec/:
#
#   docker build -f portal/cmd/badger-broker/Dockerfile.gomod -t <registry>/badger-gomod:<badger commit> .
FROM docker.io/library/golang:1.26-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS download
WORKDIR /src
COPY connectors/go.mod ./connectors/
COPY model-broker/go.mod model-broker/go.sum ./model-broker/
COPY portal/go.mod portal/go.sum ./portal/
ENV GOFLAGS=-mod=readonly GOTOOLCHAIN=local GOWORK=off
WORKDIR /src/model-broker
RUN go mod download && go mod verify
WORKDIR /src/portal
RUN go mod download && go mod verify

FROM scratch
COPY --from=download /go/pkg/mod /go/pkg/mod
